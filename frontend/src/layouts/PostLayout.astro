---
import ChannelNav from '../components/ChannelNav.astro';
import RiskNotice from '../components/RiskNotice.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  channel: 'ai' | 'trading';
  category: string;
  pubDate: Date;
  tags: string[];
  riskDisclosure: boolean;
}

const { title, description, channel, category, pubDate, tags, riskDisclosure } = Astro.props;
---

<BaseLayout title={`${title} · 知行之间`} description={description}>
  <div class="page-shell">
    <ChannelNav />
    <main class="post-page">
      <a class="back-link" href={`/${channel}/`}>← 返回{channel === 'ai' ? 'AI 应用技术分享' : '交易系统分享'}</a>
      <header class="post-header">
        <p class="section-label">{channel === 'ai' ? 'AI 应用技术分享' : '交易系统分享'} · {category}</p>
        <h1>{title}</h1>
        <p>{description}</p>
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('zh-CN')}</time>
      </header>
      {channel === 'trading' && riskDisclosure && <RiskNotice />}
      <article class="post-content"><slot /></article>
      <footer class="tag-list" aria-label="文章标签">
        {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
      </footer>
    </main>
  </div>
</BaseLayout>
