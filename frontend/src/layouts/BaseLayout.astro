---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '知行之间',
  description = 'AI 应用技术分享与交易系统分享。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
